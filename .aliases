# directories
alias l='ls -la --color'
alias p='ps aux'
alias h='dirs -v'

# editors
alias n='nano'
alias e='emacs'
alias v='vim'

# vpn
alias vp='vpnc'
alias vd='vpnc-disconnect'

# ssh
s() { ssh chris@"$@"; }
sa() { ssh -A chris@"$@"; }
sx() { ssh -X chris@"$@"; }
sax() { ssh -AX chris@"$@"; }

# misc
alias et='rm -rf ~/.local/share/Trash/*'

# python-based command line json formatter
alias jsonv='python -m json.tool'

# tailing webserver logs
# nginx:  tln, tl
# apache: tla
tl() {
  tln
}
tln() {
  local TLINES=50
  if [[ $@ = [0-9]* ]]; then
    local TLINES="$@"
  fi
  sudo tail -n "$TLINES" /var/log/nginx/error.log
}
tla() {
  local TLINES=50
  if [[ $@ = [0-9]* ]]; then
    local TLINES="$@"
  fi
  sudo tail -n "$TLINES" /var/log/apache2/error.log
}

# Git functions
function current_branch() {
  ref=$(git symbolic-ref HEAD 2> /dev/null) || \
  ref=$(git rev-parse --short HEAD 2> /dev/null) || return
  echo ${ref#refs/heads/}
}

function current_repository() {
  ref=$(git symbolic-ref HEAD 2> /dev/null) || \
  ref=$(git rev-parse --short HEAD 2> /dev/null) || return
  echo $(git remote -v | cut -d':' -f 2)
}

# Git aliases
alias g='git status'
alias gb='git branch'
alias gf='git fetch --all -v'
alias gpb='git pull origin $(current_branch)'
alias gpr='git pull --rebase origin $(current_branch) && git submodule update --init --recursive && git submodule sync'
alias gsb='git push origin $(current_branch)'
alias gsbf='git push --force origin $(current_branch)'
alias gcp='git cherry-pick'
alias ga='git add'
alias gc='git commit'
alias grhh='git reset HEAD --hard'
alias gco='git checkout'

